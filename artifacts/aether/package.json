{
  "name": "@workspace/aether",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/free-port.mjs && vite --config vite.config.ts --host 0.0.0.0",
    "prebuild": "node scripts/optimize-garment-images.mjs --verify",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import-catalog": "node scripts/import-catalog.mjs",
    "claude-import": "node scripts/claude-import.mjs",
    "regenerate-garments": "node scripts/regenerate-garments.mjs",
    "reclassify-parts": "node scripts/reclassify-parts.mjs",
    "generate-models": "node scripts/generate-models.mjs",
    "optimize-images": "node scripts/optimize-garment-images.mjs"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "framer-motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "wouter": "^3.3.5"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@replit/object-storage": "^1.0.0",
    "@unpic/react": "^1.0.2",
    "ipx": "2.1.1",
    "sharp": "^0.35.3"
  }
}
