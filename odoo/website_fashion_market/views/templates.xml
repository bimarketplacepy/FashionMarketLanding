<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categorías con la experiencia: la grilla de Odoo queda tal cual (precio,
         carrito, favoritos, comparar, filtros). Arriba de la grilla:
         - categoría raíz, primera página sin filtros: la experiencia (<fm-moda>);
         - resto: <fm-tienda>, que sólo suma "Probalo en un modelo" a las tarjetas. -->
    <template id="products_fm" inherit_id="website_sale.products" name="Fashion Market: experiencia sobre la grilla">
        <xpath expr="//div[@id='o_wsale_container']" position="before">
            <t t-if="fm">
                <fm-moda t-if="fm_full" t-att-data-base="fm['base']" t-att-data-assets="fm['assets']"
                         t-att-data-moda-url="fm_moda_url" data-view="home">
                    <script type="application/json" class="fm-scope" t-out="fm_scope_json"/>
                </fm-moda>
                <fm-tienda t-else="" t-att-data-base="fm['base']" t-att-data-assets="fm['assets']"
                           t-att-data-moda-url="fm_moda_url">
                    <script type="application/json" class="fm-scope" t-out="fm_scope_json"/>
                </fm-tienda>
                <link rel="preconnect" t-att-href="fm['assets']" crossorigin=""/>
                <script type="module" t-att-src="fm['script']" crossorigin=""/>
            </t>
        </xpath>
    </template>

    <!-- Ficha de producto: "Probalo en un modelo" para las prendas del motor. -->
    <template id="product_fm_probar" inherit_id="website_sale.product" name="Fashion Market: probalo en un modelo">
        <xpath expr="//div[@id='o_wsale_product_details_content']" position="inside">
            <t t-set="fm_probar" t-value="product._fm_probar_values()"/>
            <t t-if="fm_probar">
                <fm-probar t-att-data-base="fm_probar['base']" t-att-data-assets="fm_probar['assets']"
                           t-att-data-garment="fm_probar['garment']" t-att-data-moda-url="fm_probar['moda_url']"/>
                <script type="module" t-att-src="fm_probar['script']" crossorigin=""/>
            </t>
        </xpath>
    </template>
</odoo>
